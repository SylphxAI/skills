{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "outcome-receipt.schema.json",
  "title": "Outcome receipt",
  "description": "Evidence that the user's actual result satisfied the declared outcome oracle - or failed, recovered, or remained unresolved. The user's product/system owns the oracle; the Control Plane owns live recording and reconciliation; this schema is the shared recording contract.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "receiptId",
    "capability",
    "context",
    "result",
    "recordedAt",
    "recordedBy"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160,
      "description": "Stable identifier of the receipt (e.g. uuid)."
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "packageDigest", "sourceRevision"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "packageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sourceRevision": { "type": "string", "minLength": 7, "maxLength": 64 },
        "qualified": { "type": "boolean" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": ["runtime"],
      "properties": {
        "runtime": { "enum": ["codex", "claude", "grok", "other"] },
        "model": { "type": "string", "maxLength": 200 },
        "environment": { "type": "string", "maxLength": 300 },
        "attemptId": { "type": "string", "maxLength": 160 }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "declaredAt"],
      "properties": {
        "owner": { "enum": ["user-system", "repository", "host"] },
        "declaredAt": { "type": "string", "format": "date-time" },
        "checker": { "type": "string", "maxLength": 300 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "observedAt"],
      "properties": {
        "status": { "enum": ["succeeded", "failed", "recovered", "unresolved"] },
        "observedAt": { "type": "string", "format": "date-time" },
        "evidenceRef": { "type": "string", "maxLength": 400 },
        "detail": { "type": "string", "maxLength": 2000 }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current": { "type": "boolean" },
        "qualified": { "type": "boolean" },
        "authorized": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 400 }
      }
    },
    "recordedAt": { "type": "string", "format": "date-time" },
    "recordedBy": { "type": "string", "minLength": 2, "maxLength": 120 }
  }
}
