{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qualification-record.schema.json",
  "title": "Qualification record",
  "description": "Reproducible, version-scoped evidence that a capability version is safe, applicable, current and outcome-positive in declared environments. A named evaluator or attestor owns the result; this record only carries it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "status"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": ["unqualified", "qualified", "expired"],
      "description": "unqualified is the honest default. qualified requires evidence below. expired means a prior qualification outlived its expiresAt and is no longer eligible."
    },
    "packageDigest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ],
      "description": "Current-algorithm identity of the capability bytes this record attests (SKILL.md, references/, scripts/, capability.json, agents/). Required and equal to the live package digest when status is qualified. Any material byte change invalidates the record."
    },
    "evaluator": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "kind"],
          "properties": {
            "name": { "type": "string", "minLength": 2, "maxLength": 120 },
            "kind": { "enum": ["author", "independent", "host", "vendor"] },
            "uri": { "type": "string", "format": "uri", "maxLength": 400 }
          }
        }
      ]
    },
    "qualifiedAt": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }]
    },
    "expiresAt": {
      "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }],
      "description": "Qualification is perishable: currentness expires at expiresAt. Required and in the future when status is qualified."
    },
    "evidence": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "minLength": 2, "maxLength": 120 },
          "kind": {
            "enum": [
              "incremental-value",
              "activation",
              "compatibility",
              "automated-pattern-scan"
            ]
          },
          "digest": {
            "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }]
          },
          "uri": { "type": "string", "maxLength": 400 }
        }
      }
    },
    "compatibility": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["environment", "result"],
        "properties": {
          "environment": { "type": "string", "minLength": 2, "maxLength": 200 },
          "result": { "enum": ["verified", "failed", "not-tested"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "qualified" } } },
      "then": {
        "required": ["evaluator", "qualifiedAt", "expiresAt", "evidence", "packageDigest"],
        "properties": {
          "evaluator": { "not": { "type": "null" } },
          "qualifiedAt": { "not": { "type": "null" } },
          "expiresAt": { "not": { "type": "null" } },
          "evidence": { "minItems": 1 },
          "packageDigest": { "not": { "type": "null" } }
        }
      }
    },
    {
      "if": {
        "anyOf": [
          { "properties": { "status": { "const": "unqualified" } } },
          { "properties": { "status": { "const": "expired" } } }
        ]
      },
      "then": {
        "properties": {
          "evaluator": { "type": "null" },
          "qualifiedAt": { "type": "null" },
          "packageDigest": { "type": "null" },
          "evidence": { "maxItems": 0 },
          "compatibility": { "maxItems": 0 }
        }
      }
    }
  ]
}
