{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "eval-suite.schema.json",
  "title": "Eval suite",
  "description": "Version-scoped qualification suite for one capability: deterministic functional tasks, optional fresh-context agent comparison, and a security scan, with deterministic oracles. Named evaluator owns the result; the runner records raw artifacts and digests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capability",
    "claim",
    "evaluator",
    "validityDays",
    "tasks"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "claim": {
      "type": "string",
      "minLength": 8,
      "maxLength": 400
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "author",
            "independent",
            "host",
            "vendor"
          ]
        },
        "uri": {
          "type": "string",
          "maxLength": 400
        }
      }
    },
    "validityDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    },
    "environment": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 200
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prompt"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 4000
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "description",
          "oracle"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "exec",
              "agent"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 4,
            "maxLength": 300
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          },
          "prompt": {
            "type": "string",
            "minLength": 20,
            "maxLength": 8000
          },
          "fixtures": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "as"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 200
                },
                "as": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 5000,
            "maximum": 900000
          },
          "oracle": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assertions"
            ],
            "properties": {
              "assertions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 24,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "exit-code-eq",
                        "file-exists",
                        "file-size-min",
                        "image-dimensions",
                        "image-corner-alpha",
                        "json-path-eq",
                        "json-path-matches",
                        "stdout-contains",
                        "stdout-not-contains",
                        "dir-entry-count-eq",
                        "file-regex",
                        "file-not-regex",
                        "json-schema-valid",
                        "dir-entry-count-min"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "value": {},
                    "corner": {
                      "enum": [
                        "top-left",
                        "top-right",
                        "bottom-left",
                        "bottom-right"
                      ]
                    },
                    "opaque": {
                      "type": "boolean"
                    },
                    "jsonPath": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "contains": {
                      "type": "string",
                      "maxLength": 400
                    },
                    "min": {
                      "type": "integer"
                    },
                    "max": {
                      "type": "integer"
                    },
                    "schema": {
                      "type": "string",
                      "maxLength": 300
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
