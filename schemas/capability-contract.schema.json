{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "capability-contract.schema.json",
  "title": "Capability contract",
  "description": "Machine-readable declaration of one portable user job: boundaries, inputs/outputs, required tools/data/permissions, failure semantics, and an externally observable outcome contract. The package source owns this declaration; it never owns the truth of its claims.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "job",
    "boundaries",
    "outputs",
    "failureSemantics",
    "outcome"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Must equal the package folder name."
    },
    "job": {
      "type": "string",
      "minLength": 4,
      "maxLength": 160,
      "description": "The one requestable user job this capability performs."
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inScope"],
      "properties": {
        "inScope": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 200 }
        },
        "outOfScope": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 3, "maxLength": 200 }
        }
      }
    },
    "inputs": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 2, "maxLength": 200 },
      "description": "What the user or agent must supply before the job can start."
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 3, "maxLength": 200 },
      "description": "The durable artifacts or results the capability produces."
    },
    "required": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 200 }
        },
        "data": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 200 }
        },
        "permissions": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 2, "maxLength": 200 }
        }
      }
    },
    "failureSemantics": {
      "type": "string",
      "minLength": 8,
      "maxLength": 400,
      "description": "How failures manifest, how the capability recovers, and what is left unresolved."
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observable", "oracleOwner"],
      "properties": {
        "observable": {
          "type": "string",
          "minLength": 8,
          "maxLength": 400,
          "description": "An externally observable signal that the user's actual result satisfied the outcome contract."
        },
        "oracleOwner": {
          "enum": ["user-system", "repository", "host"],
          "description": "Who owns the oracle: the user's product/system (default), this repository, or the host runtime."
        },
        "receiptSchema": {
          "const": "outcome-receipt.schema.json",
          "description": "Every outcome is recorded against the shared outcome-receipt schema."
        }
      }
    }
  }
}
