{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sylphx.com/schemas/adr-record.schema.json",
  "title": "Lightweight ADR frontmatter",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "status"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "superseded"]
    },
    "date": { "type": "string" },
    "decision_owner": { "type": "string" },
    "supersedes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "amends": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Optional retrieval hints only; not a policy language."
    }
  }
}
