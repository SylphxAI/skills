          },
          {
            "type": "file-regex",
            "path": "README-marks.md",
            "contains": "shields.io",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "README-marks.md",
            "contains": "badge",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "README-marks.md",
            "contains": "alt",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "README-marks.md",
            "contains": "residual",
            "caseInsensitive": true
          }
        ]
      }
    }
  ],
  "activation": {
    "cases": [
      {
        "id": "user-asks-readme-badges",
        "description": "User asks for README badges without naming any skill; a fresh agent must natively discover and apply compose-readme-marks.",
        "prompt": "Add a professional badge row and a short hero section to our open-source library's README: write README-marks.md with copy-paste Markdown for build, coverage, version, and license badges with proper alt text and purpose labels.",
        "selectionKeywords": [
          "compose-readme-marks",
          "README marks",
          "shields.io",
          "badge row"
        ],
        "timeoutMs": 600000,
        "oracle": {
          "assertions": [
            {
              "type": "file-exists",
