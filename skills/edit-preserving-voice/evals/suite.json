{
  "schemaVersion": 1,
  "capability": "edit-preserving-voice",
  "claim": "Edits text preserving voice, constraints, and every protected fact and claim, with no unsupported additions, omissions, or certainty shifts.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "Rewrite source.txt as a clearer, more professional launch announcement, keeping all the facts and numbers exactly as they are."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Fresh-context agent with the full procedure rewrites the announcement while preserving every protected fact.",
      "fixtures": [
        {
          "source": "package:SKILL.md",
          "as": "SKILL.md"
        },
        {
          "source": "source.txt",
          "as": "source.txt"
        }
      ],
      "prompt": "Read ./SKILL.md completely (open references/voice-preserving-rules.md for hard-to-verify preservation), then rewrite source.txt as edited.txt: a clearer, more professional launch announcement in the same register. Lock and preserve every protected fact: names, dates, prices, numbers, percentages, regions, team lead, and the explicit uncertainty about APAC. Add no new facts, numbers, examples, or claims; do not shift certainty. Return only the edited text in edited.txt.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "edited.txt"
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "Acme Edge",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "2026-09-01",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "0.0045",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "0.012",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "2027-03-31",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "3,214",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "42 countries",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
            "contains": "99.95%",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "edited.txt",
