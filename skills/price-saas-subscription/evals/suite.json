{
  "schemaVersion": 1,
  "capability": "price-saas-subscription",
  "claim": "Produces a Pricing and Packaging Decision with an internally consistent arithmetic pass, named value metric and plan boundaries, margin guardrails, and a bounded rollout plan with kill criteria.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "Write pricing-decision.md for our SaaS project-management tool: what plans to offer, how to meter usage, and what prices are internally consistent with our costs."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Fresh-context agent with the full procedure produces the Pricing and Packaging Decision.",
      "fixtures": [
        {
          "source": "package:SKILL.md",
          "as": "SKILL.md"
        }
      ],
      "prompt": "Read ./SKILL.md completely (open references/pricing-packaging-patterns.md), then write pricing-decision.md for a B2B SaaS project-management tool (10k users, seats + automation runs as cost drivers, 70% gross margin target, annual prepay discount 20%): name the decision/buyer/value metric; choose the packaging model; design plan boundaries with exact limits, upgrade moments, and downgrade/cancel promises; run an explicit pricing arithmetic pass (seat minimums vs included seats, included usage vs overage rates, margin, annual discount) that is internally consistent; set margin guardrails; and give a bounded rollout plan with kill criteria before any discounting.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "pricing-decision.md"
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "value metric",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "plan",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "arithmetic",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "margin",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "guardrail",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "kill criteria",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "rollout",
            "caseInsensitive": true
          }
        ]
      }
    },
    {
      "id": "baseline-agent",
      "kind": "agent",
      "baseline": true,
      "description": "Fresh-context baseline (no skill): same task, same pricing oracle.",
      "prompt": "Write pricing-decision.md for our SaaS project-management tool: what plans to offer, how to meter usage, and what prices are internally consistent with our costs.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "pricing-decision.md"
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "value metric",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "plan",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "arithmetic",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "margin",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "guardrail",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "kill criteria",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "pricing-decision.md",
            "contains": "rollout",
            "caseInsensitive": true
          }
        ]
      }
    }
  ],
  "activation": {
    "cases": [
      {
        "id": "user-asks-pricing",
        "description": "User asks for pricing design without naming any skill; a fresh agent must natively discover and apply price-saas-subscription.",
        "prompt": "We run a B2B SaaS project-management tool (10k users; seats and automation runs drive our costs; we target 70% gross margin and offer 20% off annual prepay). Write pricing-decision.md: what plans to offer, the value metric, exact plan boundaries, and a price set that is internally consistent with our costs.",
        "selectionKeywords": [
          "price-saas-subscription",
          "Pricing and Packaging Decision",
          "value metric",
          "margin guardrail"
        ],
        "timeoutMs": 600000,
        "oracle": {
          "assertions": [
            {
              "type": "file-exists",
              "path": "pricing-decision.md"
