{
  "schemaVersion": 1,
  "capability": "model-security-threats",
  "claim": "Produces a Threat Model and Security Design Contract: protected assets, trust boundaries, evidence-ranked threats, controls traced to threats, and falsifiable verification.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "Write threat-model.md for a public checkout flow (client browser, TLS edge, payment provider, internal ledger). List the main threats and what controls you would put in place."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Skill installed as the only condition; identical user prompt; no SKILL.md fixture.",
      "prompt": "Write threat-model.md for a public checkout flow (client browser, TLS edge, payment provider, internal ledger). List the main threats and what controls you would put in place.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "threat-model.md"
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "trust boundary",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "asset",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "unacceptable outcome",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "threat",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "likelihood",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "control",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "falsif",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "threat-model.md",
            "contains": "residual risk",
            "caseInsensitive": true
          }
        ]
      }
    },
