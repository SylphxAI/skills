            "contains": "deletion",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "context-contract.md",
            "contains": "handoff",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "context-contract.md",
            "contains": "stale",
            "caseInsensitive": true
          }
        ]
      }
    }
  ],
  "activation": {
