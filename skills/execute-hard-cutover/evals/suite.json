{
  "schemaVersion": 1,
  "capability": "execute-hard-cutover",
  "claim": "Produces an executed cutover plan: named predecessor/destination with sole-writer terminal, dependency inventory, backfill, traffic cut, retirement, evidence, and residuals.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "Write cutover.md planning how to replace an old payment API with a new one and remove the old path. Cover what must move, how traffic switches, and how you know it is done."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Skill installed as the only condition; identical user prompt; no SKILL.md fixture.",
      "prompt": "Write cutover.md planning how to replace an old payment API with a new one and remove the old path. Cover what must move, how traffic switches, and how you know it is done.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "cutover.md"
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "predecessor",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "destination",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "sole writer",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "retire",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "backfill",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "evidence",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "residual",
            "caseInsensitive": true
          }
        ]
      }
    },
    {
      "id": "baseline-agent",
      "kind": "agent",
      "baseline": true,
      "description": "No skill installed; identical prompt.",
      "prompt": "Write cutover.md planning how to replace an old payment API with a new one and remove the old path. Cover what must move, how traffic switches, and how you know it is done.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "cutover.md"
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "predecessor",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "destination",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "sole writer",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "retire",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "backfill",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "evidence",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "cutover.md",
            "contains": "residual",
            "caseInsensitive": true
          }
        ]
      }
    }
  ]
}
