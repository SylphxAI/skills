            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "feedback-loop.md",
            "contains": "authority",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "feedback-loop.md",
            "contains": "routing",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
