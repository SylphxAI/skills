{
  "schemaVersion": 1,
  "capability": "run-incident-response",
  "claim": "Produces an incident record: declared severity/scope/impact/owner, mitigation evidence, communications, diagnosis, resolution, and postmortem with action items and owners.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "Write incident.md describing how you would handle a production outage where the website returns 502s. Cover what you do first, how you communicate, and what you learn afterward."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Skill installed as the only condition; identical user prompt; no SKILL.md fixture.",
      "prompt": "Write incident.md describing how you would handle a production outage where the website returns 502s. Cover what you do first, how you communicate, and what you learn afterward.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "incident.md"
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "severity",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "mitigat",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "communicat",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "cause",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "postmortem",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "action item",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "owner",
            "caseInsensitive": true
          }
        ]
      }
    },
    {
      "id": "baseline-agent",
      "kind": "agent",
      "baseline": true,
      "description": "No skill installed; identical prompt.",
      "prompt": "Write incident.md describing how you would handle a production outage where the website returns 502s. Cover what you do first, how you communicate, and what you learn afterward.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "incident.md"
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "severity",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "mitigat",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "communicat",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "cause",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "postmortem",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "action item",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "incident.md",
            "contains": "owner",
            "caseInsensitive": true
          }
        ]
      }
    }
  ]
}
