{
  "schemaVersion": 1,
  "capability": "research-public-web",
  "claim": "Produces a decision-ready research answer with cited URLs, free-path vs paid-path labeling, and explicit adapter gaps.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20",
    "network (public web)"
  ],
  "baseline": {
    "prompt": "Write research.md answering: 'What are the current system requirements of the Node.js LTS release?' Include where you got the information."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Fresh-context agent with the full procedure produces the cited research answer with gaps.",
      "fixtures": [
        {
          "source": "package:SKILL.md",
          "as": "SKILL.md"
        }
      ],
      "prompt": "Read ./SKILL.md completely (open references/recipes.md first), then write research.md answering: 'What are the current system requirements of the Node.js LTS release?' Follow the method: frame the question, search with free paths first, fetch and extract with URLs/retrieved time/excerpts, note adapter failures as gaps, then synthesize answer-first with citations, contradictions, and unknowns. Label free-path vs paid-path usage and list gaps (blocked hosts, stale pages, thin evidence).",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "research.md"
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "http",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "source",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "gap",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "free path",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "node",
            "caseInsensitive": true
          }
        ]
      }
    },
    {
      "id": "baseline-agent",
      "kind": "agent",
      "baseline": true,
      "description": "Fresh-context baseline (no skill): same task, same citation oracle.",
      "prompt": "Write research.md answering: 'What are the current system requirements of the Node.js LTS release?' Include where you got the information.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "research.md"
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "http",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "source",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "gap",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "free path",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "research.md",
            "contains": "node",
            "caseInsensitive": true
          }
        ]
      }
    }
  ],
  "activation": {
    "cases": [
      {
        "id": "user-asks-web-research",
        "description": "User asks for web research with sources without naming any skill; a fresh agent must natively discover and apply research-public-web.",
        "prompt": "Write research.md answering: 'What are the current system requirements of the Node.js LTS release?' Include where you got the information and any limits you hit.",
        "selectionKeywords": [
          "research-public-web",
          "Research Public Web",
          "free path",
          "adapter gap"
        ],
        "timeoutMs": 600000,
        "oracle": {
          "assertions": [
            {
              "type": "file-exists",
              "path": "research.md"
            },
            {
              "type": "file-regex",
              "path": "research.md",
              "contains": "http",
              "caseInsensitive": true
            },
            {
              "type": "file-regex",
              "path": "research.md",
              "contains": "source",
              "caseInsensitive": true
            },
            {
              "type": "file-regex",
              "path": "research.md",
              "contains": "gap",
              "caseInsensitive": true
            },
            {
              "type": "file-regex",
              "path": "research.md",
              "contains": "free",
              "caseInsensitive": true
            },
            {
              "type": "file-regex",
              "path": "research.md",
              "contains": "node",
              "caseInsensitive": true
            },
            {
              "type": "file-regex",
              "path": "research.md",
              "contains": "paid",
              "caseInsensitive": true
            }
          ]
        }
      }
    ]
  }
}
