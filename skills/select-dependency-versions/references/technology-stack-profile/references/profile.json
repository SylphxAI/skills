{
  "$schema": "./enterprise-profile.schema.json",
  "schemaVersion": 4,
  "kind": "EnterpriseProfile",
  "profile": {
    "id": "technology-stack-profile",
    "revision": "2026-08-12.1",
    "contentDigest": "sha256:183c1ee98c728525d54b039ac77ea3b821d48380bff0cb7a7dc6399bdd7ad89b",
    "contentDigestScope": "canonical-json-excluding:/profile/contentDigest",
    "owner": "SylphxAI/skills",
    "decisionRef": "references/ADR-20260812-atlas-database-migration-stack.md",
    "lifecycle": "active",
    "authorityClass": "governance-constraint",
    "effectiveOn": "2026-08-12",
    "reviewBy": "2026-11-12"
  },
  "selector": {
    "matchAll": [
      {
        "fact": "repository.lifecycle",
        "operator": "one-of",
        "values": [
          "active",
          "commercial",
          "incubating",
          "maintenance",
          "production"
        ]
      },
      {
        "fact": "task.surface",
        "operator": "one-of",
        "values": [
          "language-boundary-audit",
          "migration-completion",
          "product-code",
          "runtime-implementation"
        ]
      }
    ],
    "unknownFactPolicy": "fail-closed"
  },
  "defaults": [
    {
      "key": "engineering.language.backend-required-technology",
      "assertionIds": [
        "backend-role-requirement"
      ],
      "rationale": "Rust is the required production technology for backend runtime and durable business effects.",
      "constraints": [
        "Repair missing or defective backend behavior in Rust.",
        "Do not use TypeScript as backend fallback, dual-run implementation, shadow production, recovery path, or implementation-delay mechanism."
      ]
    },
    {
      "key": "engineering.language.web-required-technology",
      "assertionIds": [
        "web-role-requirement"
      ],
      "rationale": "TypeScript, Bun, and Next are intended production technologies for browser and server-rendered product web.",
      "constraints": [
        "Web may render, compose UI data, and orchestrate calls through backend contracts.",
        "Web must not own backend database mutations, durable queues, backend business effects, backend authorization decisions, or TypeScript backend fallback."
      ]
    },
    {
      "key": "engineering.language.completion-measure",
      "assertionIds": [
        "role-effect-completion"
      ],
      "rationale": "Completion is semantic coverage of declared service roles and effects, not a source-file statistic.",
      "constraints": [
        "Never use .ts file count, repository language totals, Bun process presence, or endpoint-shell parity as completion evidence.",
        "Keep source, validation, deployment, and live-production proof distinct."
      ]
    },
    {
      "key": "engineering.contract.cross-platform-required-stack",
      "assertionIds": [
        "cross-platform-contract-stack"
      ],
      "rationale": "One generated Protobuf and Connect contract stack prevents backend, web, native applications, and SDKs from independently re-authoring product semantics.",
      "constraints": [
        "Use the selected contract, server, transport, and client libraries for every public, cross-runtime, cross-repository, or independently versioned RPC boundary.",
        "Do not create a second wire model, client-specific API, or framework-authored copy of generated message and method semantics."
      ]
    },
    {
      "key": "engineering.interoperability.event-and-telemetry",
      "assertionIds": [
        "interoperability-stack"
      ],
      "rationale": "CloudEvents standardizes cross-boundary event context while OpenTelemetry standardizes protected operational signals without creating another business contract.",
      "constraints": [
        "Use CloudEvents only as the outer envelope for cross-boundary integration events; the schema-first payload remains semantic authority and local domain events need no transport wrapper.",
        "Bind OpenTelemetry at adapters and bootstrap, keep raw operator evidence protected, and expose public operational facts only through an explicit allowlisted product or protocol contract."
      ]
    },
    {
      "key": "engineering.database.migration-required-stack",
      "assertionIds": [
        "database-migration-stack"
      ],
      "rationale": "One language-agnostic Atlas versioned migration authority prevents per-repository engine forks and ORM push-to-prod, while CI replay and destructive gates protect live data.",
      "constraints": [
        "Use Atlas as the sole production schema-change applicator for relational product databases on every language and project size.",
        "Ban ORM push to live databases, a second production migration runner, unpinned Atlas CLI binaries, and migrate-down as ordinary recovery."
      ]
    }
  ],
  "assertions": {
    "digestBinding": "profile-content-digest",
    "factModel": {
      "componentCollectionPointer": "/architecture/components",
      "roleField": "role",
      "implementationField": "implementation",
      "ownedEffectsField": "ownedEffects"
    },
    "rules": [
      {
        "id": "selector-resolution",
        "kind": "selector-outcome",
        "aggregation": "match-all",
        "precedence": [
          "conflict",
          "unmatched",
          "unknown",
          "matched"
        ],
        "outcomes": {
          "matched": "selected",
          "unmatched": "not-selected",
          "unknown": "blocked",
          "conflict": "blocked"
        }
      },
      {
        "id": "owned-effect-classification",
        "kind": "effect-classification",
        "classes": [
          {
            "id": "backend-effect",
            "effects": [
              "backend-authorization-decision",
              "backend-business-effect",
              "backend-database-mutation",
              "durable-queue-consume",
              "durable-queue-publish"
            ]
          },
          {
            "id": "typescript-backend-fallback",
            "effects": [
              "typescript-backend-fallback"
            ]
          }
        ],
        "noMatchDisposition": "unknown",
        "multipleMatchDisposition": "ambiguous",
        "unknownOutcome": "blocked",
        "ambiguousOutcome": "blocked"
      },
      {
        "id": "backend-role-requirement",
        "kind": "role-requirement",
        "roles": [
          "api",
          "backend-service",
          "background-job",
          "controller",
          "critical-path",
          "gateway",
          "queue-consumer",
          "queue-producer",
          "runtime",
          "storage",
          "worker"
        ],
        "requiredImplementation": "rust",
        "effectClassificationId": "owned-effect-classification",
        "effectClassAllowances": [
          {
            "effectClass": "backend-effect",
            "disposition": "allowed"
          },
          {
            "effectClass": "typescript-backend-fallback",
            "disposition": "forbidden"
          }
        ],
        "implementationMismatchOutcome": "violation",
        "forbiddenEffectOutcome": "violation",
        "unmappedEffectClassOutcome": "blocked"
      },
      {
        "id": "web-role-requirement",
        "kind": "role-requirement",
        "roles": [
          "browser",
          "product-web",
          "server-rendered-web",
          "ui-orchestration"
        ],
        "requiredImplementation": "typescript-bun-next",
        "effectClassificationId": "owned-effect-classification",
        "effectClassAllowances": [
          {
            "effectClass": "backend-effect",
            "disposition": "forbidden"
          },
          {
            "effectClass": "typescript-backend-fallback",
            "disposition": "forbidden"
          }
        ],
        "implementationMismatchOutcome": "violation",
        "forbiddenEffectOutcome": "violation",
        "unmappedEffectClassOutcome": "blocked"
      },
      {
        "id": "role-effect-completion",
        "kind": "completion-denominator",
        "componentSet": "declared-components",
        "denominator": [
          "declared-component-role",
          "declared-owned-effect"
        ],
        "successCondition": "every-denominator-item-conforms",
        "successOutcome": "conforming",
        "emptyComponentSetOutcome": "blocked",
        "missingFactOutcome": "blocked",
        "ambiguousRuleOutcome": "blocked"
      },
      {
        "id": "cross-platform-contract-stack",
        "kind": "contract-stack-requirement",
        "appliesTo": [
          "cross-repository",
          "cross-runtime",
          "independently-versioned-sdk",
          "public-api"
        ],
        "contract": {
          "schemaLanguage": "protobuf-editions",
          "editionPolicy": "latest-released-full-matrix",
          "toolchain": "buf",
          "semanticValidation": "protovalidate",
          "compatibility": "buf-breaking"
        },
        "server": {
          "implementation": "rust",
          "messageRuntime": "buffa",
          "rpcRuntime": "connectrpc",
          "httpRuntime": "axum+tower"
        },
        "transport": {
          "defaultProtocol": "connect",
          "servedProtocols": [
            "connect",
            "grpc",
            "grpc-web"
          ],
          "nativeDefaultEncoding": "protobuf-binary",
          "browserDefaultEncoding": "protojson",
          "grpcWebDisposition": "compatibility-only"
        },
        "clients": [
          {
            "platform": "web-react",
            "messageRuntime": "@bufbuild/protobuf",
            "rpcRuntime": "@connectrpc/connect-web",
            "protocol": "connect",
            "applicationState": [
              "@connectrpc/connect-query+@tanstack/react-query",
              "react-state",
              "zustand-only-for-cross-component-client-owned-state"
            ],
            "offlineStore": null
          },
          {
            "platform": "dart-flutter",
            "messageRuntime": "protobuf-dart",
            "rpcRuntime": "connectrpc",
            "protocol": "connect",
            "applicationState": [
              "riverpod"
            ],
            "offlineStore": "drift-when-offline-required"
          },
          {
            "platform": "swift-apple",
            "messageRuntime": "SwiftProtobuf",
            "rpcRuntime": "Connect",
            "protocol": "connect",
            "applicationState": [
              "swift-observation",
              "swiftui-state"
            ],
            "offlineStore": "GRDB-when-offline-required"
          },
          {
            "platform": "kotlin-android",
            "messageRuntime": "protobuf-kotlin",
            "rpcRuntime": "connect-kotlin",
            "protocol": "connect",
            "applicationState": [
              "coroutines-flow",
              "compose-viewmodel-state"
            ],
            "offlineStore": "room-when-offline-required"
          },
          {
            "platform": "rust-native",
            "messageRuntime": "buffa",
            "rpcRuntime": "connectrpc",
            "protocol": "connect",
            "applicationState": [
              "native-application-state"
            ],
            "offlineStore": null
          },
          {
            "platform": "go",
            "messageRuntime": "google.golang.org/protobuf",
            "rpcRuntime": "connectrpc.com/connect",
            "protocol": "connect",
            "applicationState": [
              "native-application-state"
            ],
            "offlineStore": null
          },
          {
            "platform": "python",
            "messageRuntime": "protobuf-py",
            "rpcRuntime": "connectrpc",
            "protocol": "connect",
            "applicationState": [
              "native-application-state"
            ],
            "offlineStore": null
          },
          {
            "platform": "node-typescript",
            "messageRuntime": "@bufbuild/protobuf",
            "rpcRuntime": "@connectrpc/connect-node",
            "protocol": "connect",
            "applicationState": [
              "native-application-state"
            ],
            "offlineStore": null
          },
          {
            "platform": "dotnet",
            "messageRuntime": "Google.Protobuf",
            "rpcRuntime": "Grpc.Net.Client",
            "protocol": "grpc",
            "applicationState": [
              "native-application-state"
            ],
            "offlineStore": null
          }
        ],
        "unknownClientOutcome": "blocked-until-profile-review"
      },
      {
        "id": "interoperability-stack",
        "kind": "interoperability-stack-requirement",
        "integrationEvents": {
          "appliesTo": [
            "cross-capability",
            "cross-process",
            "cross-runtime",
            "cross-repository",
            "external-consumer"
          ],
          "envelope": "cloudevents",
          "versionPolicy": "latest-stable",
          "payloadAuthority": "schema-first",
          "localDomainEventDisposition": "native-typed-no-envelope-required"
        },
        "telemetry": {
          "standard": "opentelemetry",
          "semanticConventions": "stable",
          "traceContext": "w3c-trace-context",
          "sdkBoundary": "adapters-and-bootstrap",
          "operatorEvidence": "protected-by-default",
          "publicProjection": "explicit-allowlist-only"
        }
      },
      {
        "id": "database-migration-stack",
        "kind": "database-migration-stack-requirement",
        "appliesTo": [
          "relational-product-database",
          "schema-change",
          "data-backfill-with-schema",
          "migration-apply"
        ],
        "engine": {
          "name": "atlas",
          "scope": "sole-production-schema-apply-authority",
          "cliPinPolicy": "single-version-os-arch-matching-apply-images"
        },
        "mode": {
          "production": "versioned-migrations",
          "localDisposable": "versioned-migrations"
        },
        "schemaSources": [
          "orm-external-schema-loader",
          "sql-schema",
          "hcl-schema",
          "composite-schema"
        ],
        "productionBans": [
          "orm-push-to-live-database",
          "second-production-migration-runner",
          "unpinned-floating-atlas-cli",
          "macos-hash-commit-for-linux-apply",
          "migrate-down-as-ordinary-recovery"
        ],
        "ciSafety": {
          "ephemeralFullHistoryReplay": "required",
          "destructiveOrDataDependGate": "required",
          "directoryIntegrity": "required",
          "atlasMigrateLint": "when-admitted-edition-evaluates-schema-source"
        },
        "applyPolicy": {
          "direction": "forward-only-ordinary",
          "identity": "collision-resistant-migration-versions",
          "lock": "engine-native-apply-lock-required"
        },
        "revertSurface": [
          "pitr-or-volume-snapshot",
          "append-only-business-log",
          "forward-repair-migration",
          "previous-healthy-deployment"
        ],
        "queryToolRule": "runtime-query-tools-compile-against-migration-derived-schema-only",
        "unknownDialectOutcome": "blocked-until-profile-review"
      }
    ]
  },
  "exceptionPolicy": {
    "mode": "typed-expiring",
    "exceptableDefaults": [],
    "forbiddenDefaults": [
      "engineering.language.backend-required-technology",
      "engineering.contract.cross-platform-required-stack",
      "engineering.interoperability.event-and-telemetry",
      "engineering.language.completion-measure",
      "engineering.language.web-required-technology",
      "engineering.database.migration-required-stack"
    ],
    "requiredFields": [
      "id",
      "defaultKey",
      "selector",
      "rationale",
      "owner",
      "decisionRef",
      "evidence",
      "expiresOn",
      "recovery",
      "replacementCondition"
    ],
    "expiryAction": "fail-closed"
  },
  "review": {
    "triggers": [
      "A component role or effect cannot be classified deterministically.",
      "A TypeScript/Bun/Next component gains a forbidden backend effect.",
      "A backend fallback, dual-run, shadow, or recovery path appears.",
      "A selected client cannot consume the selected Protobuf edition or pass the shared protocol and fixture matrix.",
      "A new public or cross-runtime client platform has no selected generated client path.",
      "A cross-boundary integration event lacks a CloudEvents envelope or re-authors its payload semantics.",
      "OpenTelemetry SDK types enter domain policy or raw operator telemetry appears in an unintended public/customer contract.",
      "A repository uses a second production migration runner, ORM push to a live database, or unpinned Atlas apply binary.",
      "CI lacks ephemeral full-history migration replay or a destructive/data-depend gate for relational schema changes.",
      "Current evidence shows a selected technology is dominated on correctness, security, privacy, legal, or an explicit task requirement.",
      "Another active profile overlaps this selector and selection key.",
      "The reviewBy date is reached."
    ]
  },
  "retirement": {
    "predecessor": "technology-stack-profile@2026-07-29.2",
    "successor": null,
    "terminal": "An admitted active successor revision covers this selector and all selection keys, the adoption system resolves selected repositories to that successor, all exceptions are closed, and this revision is marked retired.",
    "retiredRevisionSelectable": false
  }
}
