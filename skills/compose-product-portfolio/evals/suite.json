{
  "schemaVersion": 1,
  "capability": "compose-product-portfolio",
  "claim": "Produces a Composable Product Portfolio Contract where every unit has a standalone job, contract, lifecycle, and support path; every connector edge names its contract and state owner; and keep/extract/merge/retire decisions carry evidence and handoffs.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "We have one platform that also ships a mobile app, a dashboard, and an API SDK. Write portfolio-contract.md: what should be separate products, what stays embedded, and how they connect."
