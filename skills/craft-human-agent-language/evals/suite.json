{
  "schemaVersion": 1,
  "capability": "craft-human-agent-language",
  "claim": "Produces a document/prompt artifact with stated purpose and audience, clear structure, a boundary output contract, and a verification gate for model switches.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "Write document.md: a short guide for both humans and AI agents explaining how to write a bug report in this repository. Make it clear and useful."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Skill installed as the only condition; identical user prompt; no SKILL.md fixture.",
      "prompt": "Write document.md: a short guide for both humans and AI agents explaining how to write a bug report in this repository. Make it clear and useful.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "document.md"
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "purpose",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "audience",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "structure",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "output contract",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "verification",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "gate",
            "caseInsensitive": true
          }
        ]
      }
    },
    {
      "id": "baseline-agent",
      "kind": "agent",
      "baseline": true,
      "description": "No skill installed; identical prompt.",
      "prompt": "Write document.md: a short guide for both humans and AI agents explaining how to write a bug report in this repository. Make it clear and useful.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "document.md"
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "purpose",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "audience",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "structure",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "output contract",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "verification",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "document.md",
            "contains": "gate",
            "caseInsensitive": true
          }
        ]
      }
    }
  ]
}
