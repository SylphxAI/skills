{
  "schemaVersion": 1,
  "capability": "analyze-critically",
  "claim": "Produces a Critical Analysis Brief: question/stakes, facts, competing hypotheses, discriminating evidence, strongest case for/against, calibrated conclusion, and what would change the answer.",
  "evaluator": {
    "name": "Sylphx Qualification Runner",
    "kind": "host",
    "uri": "https://github.com/SylphxAI/skills/blob/main/docs/QUALIFICATION.md"
  },
  "validityDays": 90,
  "environment": [
    "codex-cli 0.147.0 (agent task)",
    "node >= 20"
  ],
  "baseline": {
    "prompt": "Write analysis.md critically reviewing the claim: 'The migration is stalled because the team is unmotivated'. Give your verdict and reasons."
  },
  "tasks": [
    {
      "id": "agent-follows-procedure",
      "kind": "agent",
      "description": "Skill installed as the only condition; identical user prompt; no SKILL.md fixture.",
      "prompt": "Write analysis.md critically reviewing the claim: 'The migration is stalled because the team is unmotivated'. Give your verdict and reasons.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "analysis.md"
          },
          {
            "type": "file-regex",
            "path": "analysis.md",
            "contains": "question",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "analysis.md",
            "contains": "stakes",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "analysis.md",
            "contains": "hypothes",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "analysis.md",
            "contains": "discriminating evidence",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "analysis.md",
            "contains": "strongest case",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "analysis.md",
            "contains": "calibrated",
            "caseInsensitive": true
          },
          {
            "type": "file-regex",
            "path": "analysis.md",
            "contains": "would change",
            "caseInsensitive": true
          }
        ]
      }
    },
    {
      "id": "baseline-agent",
      "kind": "agent",
      "baseline": true,
      "description": "No skill installed; identical prompt.",
      "prompt": "Write analysis.md critically reviewing the claim: 'The migration is stalled because the team is unmotivated'. Give your verdict and reasons.",
      "timeoutMs": 600000,
      "oracle": {
        "assertions": [
          {
            "type": "file-exists",
            "path": "analysis.md"
          },
          {
            "type": "file-regex",
